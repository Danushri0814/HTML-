<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danushri B - Contact</title>
  <meta name="description" content="Contact form to message Danushri B.">
</head>
<body>
  <a href="#main-content">Skip to main content</a>

  <header>
    <h1>Danushri B</h1>
    <nav aria-label="Main menu">
      <a href="index.html">Home</a> |
      <a href="about.html">About</a> |
      <a href="contact.html" aria-current="page">Contact</a>
    </nav>
  </header>

  <main id="main-content">
    <section aria-labelledby="contact-title">
      <h2 id="contact-title">Contact Me</h2>
      <p>Fill out the form below to send me a message.</p>

      <form aria-label="Contact form">
        <p>
          <label for="your-name">Your Name:</label><br>
          <input id="your-name" name="name" type="text" required>
        </p>

        <p>
          <label for="your-email">Your Email:</label><br>
          <input id="your-email" name="email" type="email" required>
        </p>

        <p>
          <label for="your-message">Message:</label><br>
          <textarea id="your-message" name="message" rows="4" required></textarea>
        </p>

        <button type="submit">Send</button>
      </form>
    </section>
  </main>

  <footer>
    <p>Made by Danushri B © 2026</p>
  </footer>
</body>
</html>